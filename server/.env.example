# ---- Required in production ----
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://user:password@host:5432/taara
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=https://api.example.com
CORS_ORIGINS=*

# AI astrologer, translation, horoscopes, reports (Anthropic Claude)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_FAST_MODEL=claude-haiku-5-5

# Payments (Razorpay) — create keys in the Razorpay dashboard; webhook URL: {PUBLIC_URL}/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMS OTP (MSG91 flow with an {{otp}} variable) ----
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Development only: accept this code for any phone and skip SMS. Must be empty in production.
OTP_DEV_CODE=

# ---- Optional ----
# Voice (Sarvam AI): speech-to-text in all 22 languages, spoken replies in 11
SARVAM_API_KEY=
# Sign in with Google / Apple (comma-separated OAuth client IDs; iOS bundle id)
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=in.taara.app
# Expo push (only needed if you enabled enhanced push security in Expo)
EXPO_ACCESS_TOKEN=
# Phone numbers that become admins when they first log in, e.g. +919876543210
ADMIN_PHONES=
# Where uploaded photos/ID documents are stored (use a persistent disk)
UPLOAD_DIR=/var/data/uploads

# ---- Safety & compliance ----
# Restrict the admin API to these IPs (comma-separated). Empty = any IP (still needs an admin login).
ADMIN_IP_ALLOWLIST=
# Data retention in days (defaults shown). Review with your lawyer before changing.
RETAIN_CHAT_DAYS=548
RETAIN_PALM_PHOTO_DAYS=365
RETAIN_NOTIFICATION_DAYS=180
RETAIN_ANALYTICS_DAYS=365
